#, c-format
msgid "%s free of %s"
msgstr "%s wolne z %s"

msgid "Also hide when only other devices are present"
msgstr "Ukrywaj również, gdy są tylko inne urządzenia"

msgid "Appearance"
msgstr "Wygląd"

msgid "Audio device"
msgstr "Urządzenie audio"

msgid "Behavior"
msgstr "Zachowanie"

msgid "Camera (PTP)"
msgstr "Aparat (PTP)"

msgid "Camera / Webcam"
msgstr "Aparat / Kamera internetowa"

