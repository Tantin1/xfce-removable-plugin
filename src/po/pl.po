#, c-format
msgid "%s free of %s"
msgstr "%s wolne z %s"

msgid "Also hide when only other devices are present"
msgstr "Ukrywaj również, gdy są tylko inne urządzenia"

msgid "Android phone"
msgstr "Telefon z Androidem"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Wygląd"

msgid "Attached to the panel"
msgstr "Przy panelu"

msgid "Audio device"
msgstr "Urządzenie audio"

msgid "Automatic"
msgstr "Automatyczny"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Automatyczny: pływające z zaokrąglonymi rogami, gdy pozwala na to motyw i kompozytor, w przeciwnym razie przy panelu."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Zachowanie"

msgid "Camera (PTP)"
msgstr "Aparat (PTP)"

msgid "Camera / Webcam"
msgstr "Aparat / Kamera internetowa"

msgid "Close"
msgstr "Zamknij"

msgid "Could not close the connection to the device."
msgstr "Nie udało się zamknąć połączenia z urządzeniem."

msgid "Could not mount the device."
msgstr "Nie można zamontować urządzenia."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Nie udało się otworzyć urządzenia. Jeśli to telefon, odblokuj go i wybierz „Przesyłanie plików” w powiadomieniu USB."

msgid "Could not unmount the device."
msgstr "Nie można odmontować urządzenia."

msgid "Device ejected"
msgstr "Urządzenie wysunięte"

msgid "Device mounted"
msgstr "Urządzenie zamontowane"

msgid "Eject"
msgstr "Wysuń"

msgid "Eject failed"
msgstr "Wysunięcie nie powiodło się"

msgid "Ejecting…"
msgstr "Wysuwanie…"

msgid "File transfer is off"
msgstr "Przesyłanie plików wyłączone"

msgid "Floating"
msgstr "Pływające"

msgid "Gamepad / Joystick"
msgstr "Gamepad / Joystick"

msgid "Graphics tablet"
msgstr "Tablet graficzny"

msgid "Hide button when no removable devices"
msgstr "Ukryj przycisk, gdy nie ma urządzeń wymiennych"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Rozmiar ikony:"

msgid "Keyboard / Mouse"
msgstr "Klawiatura / mysz"

msgid "MIDI device"
msgstr "Urządzenie MIDI"

msgid "Mount"
msgstr "Zamontuj"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Montowanie i bezpieczne usuwanie dysków, telefonów i innych urządzeń USB"

msgid "Mount failed"
msgstr "Montowanie nie powiodło się"

msgid "Mounting…"
msgstr "Montowanie…"

msgid "No driver: games may not detect it"
msgstr "Brak sterownika: gry mogą go nie wykryć"

msgid "No removable devices"
msgstr "Brak wymiennych urządzeń"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Żaden sterownik systemowy nie obsłużył tego kontrolera, więc większość gier go nie wykryje (Steam nadal może z niego korzystać). Częstą przyczyną jest pakiet blokujący sterownik xpad, na przykład xone."

msgid "Not authorized to perform this operation."
msgstr "Brak uprawnień do wykonania tej operacji."

msgid "Notify about:"
msgstr "Powiadamiaj o:"

msgid "Notify when devices are connected or disconnected"
msgstr "Powiadamiaj o podłączeniu lub odłączeniu urządzeń"

msgid "Open folder"
msgstr "Otwórz folder"

msgid "Other devices"
msgstr "Inne urządzenia"

msgid "Phone"
msgstr "Telefon"

msgid "Phone (MTP)"
msgstr "Telefon (MTP)"

msgid "Phone / Camera"
msgstr "Telefon / Aparat"

msgid "Phone or camera connected"
msgstr "Podłączono telefon lub aparat"

msgid "Phone or camera disconnected"
msgstr "Odłączono telefon lub aparat"

msgid "Phone ready"
msgstr "Telefon gotowy"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Odtwarzaj dźwięk przy podłączeniu lub odłączeniu urządzeń"

msgid "Please wait, do not unplug."
msgstr "Proszę czekać, nie odłączaj."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Rozmiar wtyczki:"

#. alto del popup
msgid "Popup height:"
msgstr "Wysokość okienka:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Styl okna:"

#. ancho del popup
msgid "Popup width:"
msgstr "Szerokość okienka:"

msgid "Printer"
msgstr "Drukarka"

msgid "Properties — Removable Devices"
msgstr "Właściwości — Urządzenia wymienne"

msgid "Removable Devices"
msgstr "Urządzenia wymienne"

msgid "Removable Devices added"
msgstr "Dodano Urządzenia wymienne"

msgid "Removable device connected"
msgstr "Podłączono urządzenie wymienne"

msgid "Removable device disconnected"
msgstr "Odłączono urządzenie wymienne"

msgid "Removable devices"
msgstr "Urządzenia wymienne"

msgid "Removable disk"
msgstr "Dysk wymienny"

msgid "Safe to remove"
msgstr "Można bezpiecznie usunąć"

msgid "Safe to unplug."
msgstr "Można odłączyć urządzenie."

msgid "Safely remove"
msgstr "Bezpiecznie usuń"

msgid "Scanner"
msgstr "Skaner"

msgid "Security key / Smart card"
msgstr "Klucz bezpieczeństwa / Karta inteligentna"

msgid "Serial device / Board"
msgstr "Urządzenie szeregowe / Płytka"

msgid "Show keyboards and mice"
msgstr "Pokazuj klawiatury i myszy"

msgid "Show notifications"
msgstr "Pokaż powiadomienia"

#. botón cuadrado
msgid "Square button"
msgstr "Kwadratowy przycisk"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "Urządzenie jest używane przez inną aplikację. Zamknij otwarte na nim pliki lub terminale i spróbuj ponownie."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "Partycje zostały odmontowane, ale nie udało się wysunąć napędu."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Telefon jest podłączony tylko do ładowania lub debugowania USB. Aby zobaczyć jego pliki, odblokuj go i wybierz „Przesyłanie plików” w powiadomieniu USB."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Ten przycisk jest ukryty, gdy nic nie jest podłączone, i pojawia się ponownie po podłączeniu urządzenia."

msgid "USB device"
msgstr "Urządzenie USB"

msgid "USB device connected"
msgstr "Podłączono urządzenie USB"

msgid "USB device disconnected"
msgstr "Odłączono urządzenie USB"

msgid "Unknown"
msgstr "Nieznane"

msgid "Unmount"
msgstr "Odmontuj"

msgid "Unmount failed"
msgstr "Odmontowanie nie powiodło się"

msgid "Unmounting…"
msgstr "Odmontowywanie…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Użyj rozmiaru panelu dla ikony"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Używa motywu dźwiękowego pulpitu. Nic nie zabrzmi, jeśli dźwięki zdarzeń są wyłączone w ustawieniach wyglądu."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "Możesz go teraz umieścić w dowolnym miejscu: prawy przycisk → Przenieś."

msgid "You can now unplug the device."
msgstr "Możesz teraz odłączyć urządzenie."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "niezamontowane"
