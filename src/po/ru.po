msgstr "Не удалось закрыть соединение с устройством."

msgid "Could not mount the device."
msgstr "Не удалось подключить устройство."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Не удалось открыть устройство. Если это телефон, разблокируйте его и выберите «Передача файлов» в уведомлении о USB."

msgid "Could not unmount the device."
msgstr "Не удалось отключить устройство."

msgid "Device ejected"
msgstr "Устройство извлечено"

msgid "Device mounted"
msgstr "Устройство подключено"

msgid "Eject"
msgstr "Извлечь"

msgid "Eject failed"
msgstr "Ошибка извлечения"

msgid "Ejecting…"
msgstr "Извлечение…"

msgid "Gamepad / Joystick"
msgstr "Геймпад / джойстик"

