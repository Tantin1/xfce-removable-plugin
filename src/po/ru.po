#, c-format
msgid "%s free of %s"
msgstr "Свободно %s из %s"

msgid "Also hide when only other devices are present"
msgstr "Скрывать также, если есть только другие устройства"

msgid "Android phone"
msgstr "Телефон Android"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Внешний вид"

msgid "Attached to the panel"
msgstr "Прикреплённое к панели"

msgid "Audio device"
msgstr "Аудиоустройство"

msgid "Automatic"
msgstr "Автоматически"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Автоматически: плавающее со скруглёнными углами, если тема и композитор это позволяют, иначе прикреплённое к панели."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Поведение"

msgid "Camera (PTP)"
msgstr "Камера (PTP)"

msgid "Camera / Webcam"
msgstr "Камера / веб-камера"

msgid "Close"
msgstr "Закрыть"

msgid "Could not close the connection to the device."
msgstr "Не удалось закрыть соединение с устройством."

msgid "Could not mount the device."
msgstr "Не удалось подключить устройство."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Не удалось открыть устройство. Если это телефон, разблокируйте его и выберите «Передача файлов» в уведомлении о USB."

msgid "Could not unmount the device."
msgstr "Не удалось отключить устройство."

msgid "Device ejected"
msgstr "Устройство извлечено"

msgid "Device mounted"
msgstr "Устройство подключено"

msgid "Eject"
msgstr "Извлечь"

msgid "Eject failed"
msgstr "Ошибка извлечения"

msgid "Ejecting…"
msgstr "Извлечение…"

msgid "File transfer is off"
msgstr "Передача файлов выключена"

msgid "Floating"
msgstr "Плавающее"

msgid "Gamepad / Joystick"
msgstr "Геймпад / джойстик"

msgid "Graphics tablet"
msgstr "Графический планшет"

msgid "Hide button when no removable devices"
msgstr "Скрывать кнопку, если нет съёмных устройств"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Размер значка:"

msgid "Keyboard / Mouse"
msgstr "Клавиатура / мышь"

msgid "MIDI device"
msgstr "MIDI-устройство"

msgid "Mount"
msgstr "Подключить"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Подключение и безопасное извлечение накопителей, телефонов и других USB-устройств"

msgid "Mount failed"
msgstr "Ошибка подключения"

msgid "Mounting…"
msgstr "Подключение…"

msgid "No driver: games may not detect it"
msgstr "Нет драйвера: игры могут его не увидеть"

msgid "No removable devices"
msgstr "Нет съёмных устройств"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Ни один системный драйвер не подключил этот геймпад, поэтому большинство игр его не увидят (Steam всё равно может его использовать). Частая причина — пакет, блокирующий драйвер xpad, например xone."

msgid "Not authorized to perform this operation."
msgstr "Нет прав на выполнение этой операции."

msgid "Notify about:"
msgstr "Уведомлять о:"

msgid "Notify when devices are connected or disconnected"
msgstr "Уведомлять о подключении и отключении устройств"

msgid "Open folder"
msgstr "Открыть папку"

msgid "Other devices"
msgstr "Другие устройства"

msgid "Phone"
msgstr "Телефон"

msgid "Phone (MTP)"
msgstr "Телефон (MTP)"

msgid "Phone / Camera"
msgstr "Телефон / камера"

msgid "Phone or camera connected"
msgstr "Телефон или камера подключены"

msgid "Phone or camera disconnected"
msgstr "Телефон или камера отключены"

msgid "Phone ready"
msgstr "Телефон готов"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Воспроизводить звук при подключении и отключении устройств"

msgid "Please wait, do not unplug."
msgstr "Подождите, не отключайте устройство."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Размер плагина:"

#. alto del popup
msgid "Popup height:"
msgstr "Высота всплывающего окна:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Стиль окна:"

#. ancho del popup
msgid "Popup width:"
msgstr "Ширина всплывающего окна:"

msgid "Printer"
msgstr "Принтер"

msgid "Properties — Removable Devices"
msgstr "Свойства — Съёмные устройства"

msgid "Removable Devices"
msgstr "Съёмные устройства"

msgid "Removable Devices added"
msgstr "Съёмные устройства добавлены"

msgid "Removable device connected"
msgstr "Съёмное устройство подключено"

msgid "Removable device disconnected"
msgstr "Съёмное устройство отключено"

msgid "Removable devices"
msgstr "Съёмные устройства"

msgid "Removable disk"
msgstr "Съёмный диск"

msgid "Safe to remove"
msgstr "Безопасное извлечение"

msgid "Safe to unplug."
msgstr "Устройство можно отключить."

msgid "Safely remove"
msgstr "Безопасно извлечь"

msgid "Scanner"
msgstr "Сканер"

msgid "Security key / Smart card"
msgstr "Ключ безопасности / смарт-карта"

msgid "Serial device / Board"
msgstr "Последовательное устройство / плата"

msgid "Show keyboards and mice"
msgstr "Показывать клавиатуры и мыши"

msgid "Show notifications"
msgstr "Показывать уведомления"

#. botón cuadrado
msgid "Square button"
msgstr "Квадратная кнопка"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "Устройство используется другим приложением. Закройте открытые на нём файлы или терминалы и повторите попытку."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "Разделы отключены, но извлечь накопитель не удалось."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Телефон подключён только для зарядки или отладки по USB. Чтобы увидеть его файлы, разблокируйте его и выберите «Передача файлов» в уведомлении о USB."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Эта кнопка скрывается, когда ничего не подключено, и появляется снова при подключении устройства."

msgid "USB device"
msgstr "USB-устройство"

msgid "USB device connected"
msgstr "USB-устройство подключено"

msgid "USB device disconnected"
msgstr "USB-устройство отключено"

msgid "Unknown"
msgstr "Неизвестное"

msgid "Unmount"
msgstr "Отключить"

msgid "Unmount failed"
msgstr "Ошибка отключения"

msgid "Unmounting…"
msgstr "Отключение…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Использовать размер панели для значка"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Используется звуковая тема рабочего стола. Звука не будет, если звуки событий отключены в настройках внешнего вида."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "Теперь её можно разместить где угодно: правый щелчок → Переместить."

msgid "You can now unplug the device."
msgstr "Теперь можно отключить устройство."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "не подключено"
