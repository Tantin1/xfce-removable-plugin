msgstr "Телефон или камера подключены"

msgid "Phone or camera disconnected"
msgstr "Телефон или камера отключены"

msgid "Phone ready"
msgstr "Телефон готов"

msgid "Please wait, do not unplug."
msgstr "Подождите, не отключайте устройство."

msgid "Plugin size:"
msgstr "Размер плагина:"

msgid "Popup height:"
msgstr "Высота всплывающего окна:"

msgid "Popup width:"
msgstr "Ширина всплывающего окна:"

