msgstr "Принтер"

msgid "Properties — Removable Devices"
msgstr "Свойства — Съёмные устройства"

msgid "Removable device connected"
msgstr "Съёмное устройство подключено"

msgid "Removable device disconnected"
msgstr "Съёмное устройство отключено"

