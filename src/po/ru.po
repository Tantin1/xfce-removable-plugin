msgstr "Ошибка отключения"

msgid "Unmounting…"
msgstr "Отключение…"

msgid "Use panel icon size"
msgstr "Использовать размер панели для значка"

msgid "You can now unplug the device."
msgstr "Теперь можно отключить устройство."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "не подключено"
