#, c-format
msgid "%s free of %s"
msgstr "%s liberi su %s"

msgid "Also hide when only other devices are present"
msgstr "Nascondi anche quando ci sono solo altri dispositivi"

msgid "Android phone"
msgstr "Telefono Android"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Aspetto"

msgid "Attached to the panel"
msgstr "Attaccata al pannello"

msgid "Audio device"
msgstr "Dispositivo audio"

msgid "Automatic"
msgstr "Automatico"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Automatico: fluttuante con angoli arrotondati quando il tema e il compositore lo consentono, altrimenti attaccata al pannello."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Comportamento"

msgid "Camera (PTP)"
msgstr "Fotocamera (PTP)"

msgid "Camera / Webcam"
msgstr "Fotocamera / Webcam"

msgid "Close"
msgstr "Chiudi"

msgid "Could not close the connection to the device."
msgstr "Impossibile chiudere la connessione con il dispositivo."

msgid "Could not mount the device."
msgstr "Impossibile montare il dispositivo."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Impossibile aprire il dispositivo. Se è un telefono, sbloccalo e scegli «Trasferimento file» nella notifica USB."

msgid "Could not unmount the device."
msgstr "Impossibile smontare il dispositivo."

msgid "Device ejected"
msgstr "Dispositivo espulso"

msgid "Device mounted"
msgstr "Dispositivo montato"

msgid "Eject"
msgstr "Espelli"

msgid "Eject failed"
msgstr "Espulsione non riuscita"

msgid "Ejecting…"
msgstr "Espulsione…"

msgid "File transfer is off"
msgstr "Trasferimento file disattivato"

msgid "Floating"
msgstr "Fluttuante"

msgid "Gamepad / Joystick"
msgstr "Gamepad / Joystick"

msgid "Graphics tablet"
msgstr "Tavoletta grafica"

msgid "Hide button when no removable devices"
msgstr "Nascondi il pulsante quando non ci sono dispositivi rimovibili"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Dimensione icona:"

msgid "Keyboard / Mouse"
msgstr "Tastiera / mouse"

msgid "MIDI device"
msgstr "Dispositivo MIDI"

msgid "Mount"
msgstr "Monta"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Monta e rimuovi in sicurezza unità, telefoni e altri dispositivi USB"

msgid "Mount failed"
msgstr "Montaggio non riuscito"

msgid "Mounting…"
msgstr "Montaggio…"

msgid "No driver: games may not detect it"
msgstr "Nessun driver: i giochi potrebbero non rilevarlo"

msgid "No removable devices"
msgstr "Nessun dispositivo rimovibile"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Nessun driver di sistema ha preso in carico questo controller, quindi la maggior parte dei giochi non lo rileverà (Steam può comunque usarlo). Una causa comune è un pacchetto che blocca il driver xpad, come xone."

msgid "Not authorized to perform this operation."
msgstr "Non autorizzato a eseguire questa operazione."

msgid "Notify about:"
msgstr "Notifica per:"

msgid "Notify when devices are connected or disconnected"
msgstr "Notifica quando si collegano o si scollegano dispositivi"

msgid "Open folder"
msgstr "Apri cartella"

msgid "Other devices"
msgstr "Altri dispositivi"

msgid "Phone"
msgstr "Telefono"

msgid "Phone (MTP)"
msgstr "Telefono (MTP)"

msgid "Phone / Camera"
msgstr "Telefono / Fotocamera"

msgid "Phone or camera connected"
msgstr "Telefono o fotocamera collegato"

msgid "Phone or camera disconnected"
msgstr "Telefono o fotocamera scollegato"

msgid "Phone ready"
msgstr "Telefono pronto"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Riproduci un suono quando si collegano o si scollegano dispositivi"

msgid "Please wait, do not unplug."
msgstr "Attendere, non scollegare."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Dimensione plugin:"

#. alto del popup
msgid "Popup height:"
msgstr "Altezza popup:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Stile della finestra:"

#. ancho del popup
msgid "Popup width:"
msgstr "Larghezza popup:"

msgid "Printer"
msgstr "Stampante"

msgid "Properties — Removable Devices"
msgstr "Proprietà — Dispositivi rimovibili"

msgid "Removable Devices"
msgstr "Dispositivi rimovibili"

msgid "Removable Devices added"
msgstr "Dispositivi rimovibili aggiunto"

msgid "Removable device connected"
msgstr "Dispositivo rimovibile collegato"

msgid "Removable device disconnected"
msgstr "Dispositivo rimovibile scollegato"

msgid "Removable devices"
msgstr "Dispositivi rimovibili"

msgid "Removable disk"
msgstr "Disco rimovibile"

msgid "Safe to remove"
msgstr "Rimozione sicura"

msgid "Safe to unplug."
msgstr "È possibile scollegare il dispositivo."

msgid "Safely remove"
msgstr "Rimozione sicura"

msgid "Scanner"
msgstr "Scanner"

msgid "Security key / Smart card"
msgstr "Chiave di sicurezza / Smart card"

msgid "Serial device / Board"
msgstr "Dispositivo seriale / Scheda"

msgid "Show keyboards and mice"
msgstr "Mostra tastiere e mouse"

msgid "Show notifications"
msgstr "Mostra notifiche"

#. botón cuadrado
msgid "Square button"
msgstr "Pulsante quadrato"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "Il dispositivo è in uso da un'altra applicazione. Chiudi i file o i terminali aperti su di esso e riprova."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "Le partizioni sono state smontate, ma non è stato possibile espellere l'unità."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Il telefono è collegato solo per la ricarica o il debug USB. Per vedere i file, sbloccalo e scegli «Trasferimento file» nella notifica USB."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Questo pulsante si nasconde quando non è collegato nulla e riappare quando colleghi un dispositivo."

msgid "USB device"
msgstr "Dispositivo USB"

msgid "USB device connected"
msgstr "Dispositivo USB collegato"

msgid "USB device disconnected"
msgstr "Dispositivo USB scollegato"

msgid "Unknown"
msgstr "Sconosciuto"

msgid "Unmount"
msgstr "Smonta"

msgid "Unmount failed"
msgstr "Smontaggio non riuscito"

msgid "Unmounting…"
msgstr "Smontaggio…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Usa dimensione pannello per l'icona"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Usa il tema sonoro del desktop. Non si sente nulla se i suoni degli eventi sono disattivati nelle impostazioni di Aspetto."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "Ora puoi posizionarlo dove preferisci: clic destro → Sposta."

msgid "You can now unplug the device."
msgstr "Ora è possibile scollegare il dispositivo."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "non montato"
