#, c-format
msgid "%s free of %s"
msgstr "%s livres de %s"

msgid "Also hide when only other devices are present"
msgstr "Ocultar também quando houver apenas outros dispositivos"

msgid "Android phone"
msgstr "Telefone Android"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Aparência"

msgid "Attached to the panel"
msgstr "Junto ao painel"

msgid "Audio device"
msgstr "Dispositivo de áudio"

msgid "Automatic"
msgstr "Automático"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Automático: flutuante com cantos arredondados quando o tema e o compositor permitem; caso contrário, junto ao painel."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Comportamento"

msgid "Camera (PTP)"
msgstr "Câmera (PTP)"

msgid "Camera / Webcam"
msgstr "Câmera / Webcam"

msgid "Close"
msgstr "Fechar"

msgid "Could not close the connection to the device."
msgstr "Não foi possível encerrar a conexão com o dispositivo."

msgid "Could not mount the device."
msgstr "Não foi possível montar o dispositivo."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Não foi possível abrir o dispositivo. Se for um telefone, desbloqueie-o e escolha \"Transferência de arquivos\" na notificação USB."

msgid "Could not unmount the device."
msgstr "Não foi possível desmontar o dispositivo."

msgid "Device ejected"
msgstr "Dispositivo ejetado"

msgid "Device mounted"
msgstr "Dispositivo montado"

msgid "Eject"
msgstr "Ejetar"

msgid "Eject failed"
msgstr "Falha ao ejetar"

msgid "Ejecting…"
msgstr "Ejetando…"

msgid "File transfer is off"
msgstr "Transferência de arquivos desativada"

msgid "Floating"
msgstr "Flutuante"

msgid "Gamepad / Joystick"
msgstr "Gamepad / Joystick"

msgid "General"
msgstr "Geral"

msgid "Graphics tablet"
msgstr "Mesa digitalizadora"

msgid "Hide button when no removable devices"
msgstr "Ocultar botão quando não houver dispositivos removíveis"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Tamanho do ícone:"

msgid "Keyboard / Mouse"
msgstr "Teclado / mouse"

msgid "MIDI device"
msgstr "Dispositivo MIDI"

msgid "Mount"
msgstr "Montar"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Montar e remover com segurança unidades, telefones e outros dispositivos USB"

msgid "Mount failed"
msgstr "Falha ao montar"

msgid "Mounting…"
msgstr "Montando…"

msgid "No driver: games may not detect it"
msgstr "Sem driver: os jogos podem não detectá-lo"

msgid "No removable devices"
msgstr "Nenhum dispositivo removível"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Nenhum driver do sistema assumiu este controle, então a maioria dos jogos não vai detectá-lo (o Steam ainda pode usá-lo). Uma causa comum é um pacote que bloqueia o driver xpad, como o xone."

msgid "Not authorized to perform this operation."
msgstr "Sem autorização para realizar esta operação."

msgid "Notifications"
msgstr "Notificações"

msgid "Notify about:"
msgstr "Notificar sobre:"

msgid "Notify when devices are connected or disconnected"
msgstr "Notificar quando dispositivos forem conectados ou desconectados"

msgid "Open folder"
msgstr "Abrir pasta"

msgid "Other devices"
msgstr "Outros dispositivos"

msgid "Phone"
msgstr "Telefone"

msgid "Phone (MTP)"
msgstr "Telefone (MTP)"

msgid "Phone / Camera"
msgstr "Telefone / Câmera"

msgid "Phone or camera connected"
msgstr "Telefone ou câmera conectado"

msgid "Phone or camera disconnected"
msgstr "Telefone ou câmera desconectado"

msgid "Phone ready"
msgstr "Telefone pronto"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Tocar um som quando dispositivos forem conectados ou desconectados"

msgid "Please wait, do not unplug."
msgstr "Aguarde, não desconecte."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Tamanho do plugin:"

#. alto del popup
msgid "Popup height:"
msgstr "Altura do popup:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Estilo da janela:"

#. ancho del popup
msgid "Popup width:"
msgstr "Largura do popup:"

msgid "Printer"
msgstr "Impressora"

msgid "Properties — Removable Devices"
msgstr "Propriedades — Dispositivos removíveis"

msgid "Removable Devices"
msgstr "Dispositivos removíveis"

msgid "Removable Devices added"
msgstr "Dispositivos removíveis adicionado"

msgid "Removable device connected"
msgstr "Dispositivo removível conectado"

msgid "Removable device disconnected"
msgstr "Dispositivo removível desconectado"

msgid "Removable devices"
msgstr "Dispositivos removíveis"

msgid "Removable disk"
msgstr "Disco removível"

msgid "Safe to remove"
msgstr "Seguro para remover"

msgid "Safe to unplug."
msgstr "Pode desconectar o dispositivo."

msgid "Safely remove"
msgstr "Remover com segurança"

msgid "Scanner"
msgstr "Scanner"

msgid "Security key / Smart card"
msgstr "Chave de segurança / Cartão inteligente"

msgid "Serial device / Board"
msgstr "Dispositivo serial / Placa"

msgid "Show keyboards and mice"
msgstr "Mostrar teclados e mouses"

msgid "Show notifications"
msgstr "Mostrar notificações"

#. botón cuadrado
msgid "Square button"
msgstr "Botão quadrado"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "O dispositivo está em uso por outro aplicativo. Feche os arquivos ou terminais abertos nele e tente novamente."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "As partições foram desmontadas, mas não foi possível ejetar a unidade."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "O telefone está conectado apenas para carregar ou para depuração USB. Para ver os arquivos, desbloqueie-o e escolha \"Transferência de arquivos\" na notificação USB."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Este botão fica oculto quando nada está conectado e reaparece ao conectar um dispositivo."

msgid "USB device"
msgstr "Dispositivo USB"

msgid "USB device connected"
msgstr "Dispositivo USB conectado"

msgid "USB device disconnected"
msgstr "Dispositivo USB desconectado"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Unmount"
msgstr "Desmontar"

msgid "Unmount failed"
msgstr "Falha ao desmontar"

msgid "Unmounting…"
msgstr "Desmontando…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Usar tamanho do painel para o ícone"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Usa o tema de sons da área de trabalho. Nada é tocado se os sons de eventos estiverem desativados nas configurações de Aparência."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "Agora você pode colocá-lo onde preferir: clique direito → Mover."

msgid "You can now unplug the device."
msgstr "Agora você pode desconectar o dispositivo."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "não montado"
