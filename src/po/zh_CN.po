msgid ""
msgstr ""
"Project-Id-Version: xfce-removable-plugin 1.0.4\n"
"Report-Msgid-Bugs-To: https://github.com/Tantin1/xfce-removable-plugin/issues\n"
"POT-Creation-Date: 2026-11-10 14:06-0300\n"
"Language: zh_CN\n"
"MIME-Version: 1.0\n"
