#, c-format
msgid "%s free of %s"
msgstr "%s متاح من %s"

msgid "Also hide when only other devices are present"
msgstr "إخفاء أيضاً عند وجود أجهزة أخرى فقط"

msgid "Android phone"
msgstr "هاتف Android"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "المظهر"

msgid "Attached to the panel"
msgstr "ملتصقة باللوحة"

msgid "Audio device"
msgstr "جهاز صوت"

msgid "Automatic"
msgstr "تلقائي"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "تلقائي: عائمة بزوايا مستديرة عندما تسمح السمة والمُركِّب بذلك، وإلا فملتصقة باللوحة."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "السلوك"

msgid "Camera (PTP)"
msgstr "كاميرا (PTP)"

msgid "Camera / Webcam"
msgstr "كاميرا / كاميرا ويب"

msgid "Close"
msgstr "إغلاق"

msgid "Could not close the connection to the device."
msgstr "تعذّر إغلاق الاتصال بالجهاز."

msgid "Could not mount the device."
msgstr "تعذّر تحميل الجهاز."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "تعذّر فتح الجهاز. إن كان هاتفاً، فافتح قفله واختر «نقل الملفات» في إشعار USB الخاص به."

msgid "Could not unmount the device."
msgstr "تعذّر إلغاء تحميل الجهاز."

msgid "Device ejected"
msgstr "تم إخراج الجهاز"

msgid "Device mounted"
msgstr "تم تحميل الجهاز"

msgid "Eject"
msgstr "إخراج"

msgid "Eject failed"
msgstr "فشل الإخراج"

msgid "Ejecting…"
msgstr "جارٍ الإخراج…"

msgid "File transfer is off"
msgstr "نقل الملفات متوقف"

msgid "Floating"
msgstr "عائمة"

msgid "Gamepad / Joystick"
msgstr "ذراع ألعاب / عصا تحكم"

msgid "General"
msgstr "عام"

msgid "Graphics tablet"
msgstr "لوح رسم"

msgid "Hide button when no removable devices"
msgstr "إخفاء الزر عند عدم وجود أجهزة قابلة للإزالة"

#. tamaño del ícono
msgid "Icon size:"
msgstr "حجم الأيقونة:"

msgid "Keyboard / Mouse"
msgstr "لوحة مفاتيح / فأرة"

msgid "MIDI device"
msgstr "جهاز MIDI"

msgid "Mount"
msgstr "تحميل"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "تحميل الأقراص والهواتف وأجهزة USB الأخرى وإزالتها بأمان"

msgid "Mount failed"
msgstr "فشل التحميل"

msgid "Mounting…"
msgstr "جارٍ التحميل…"

msgid "No driver: games may not detect it"
msgstr "لا يوجد تعريف: قد لا تتعرّف عليها الألعاب"

msgid "No removable devices"
msgstr "لا توجد أجهزة قابلة للإزالة"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "لم يتولَّ أي تعريف في النظام هذه الذراع، لذا لن تتعرّف عليها معظم الألعاب (يمكن لـ Steam استخدامها مع ذلك). من الأسباب الشائعة حزمة تحظر تعريف xpad، مثل xone."

msgid "Not authorized to perform this operation."
msgstr "غير مصرح لك بتنفيذ هذه العملية."

msgid "Notifications"
msgstr "الإشعارات"

msgid "Notify about:"
msgstr "الإشعار عن:"

msgid "Notify when devices are connected or disconnected"
msgstr "إشعار عند توصيل أو فصل الأجهزة"

msgid "Open folder"
msgstr "فتح المجلد"

msgid "Other devices"
msgstr "أجهزة أخرى"

msgid "Phone"
msgstr "هاتف"

msgid "Phone (MTP)"
msgstr "هاتف (MTP)"

msgid "Phone / Camera"
msgstr "هاتف / كاميرا"

msgid "Phone or camera connected"
msgstr "تم توصيل هاتف أو كاميرا"

msgid "Phone or camera disconnected"
msgstr "تم فصل هاتف أو كاميرا"

msgid "Phone ready"
msgstr "الهاتف جاهز"

msgid "Play a sound when devices are connected or disconnected"
msgstr "تشغيل صوت عند توصيل أو فصل الأجهزة"

msgid "Please wait, do not unplug."
msgstr "يرجى الانتظار، لا تفصل الجهاز."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "حجم الإضافة:"

#. alto del popup
msgid "Popup height:"
msgstr "ارتفاع النافذة المنبثقة:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "نمط النافذة:"

#. ancho del popup
msgid "Popup width:"
msgstr "عرض النافذة المنبثقة:"

msgid "Printer"
msgstr "طابعة"

msgid "Properties — Removable Devices"
msgstr "الخصائص — الأجهزة القابلة للإزالة"

msgid "Removable Devices"
msgstr "الأجهزة القابلة للإزالة"

msgid "Removable Devices added"
msgstr "تمت إضافة الأجهزة القابلة للإزالة"

msgid "Removable device connected"
msgstr "تم توصيل جهاز قابل للإزالة"

msgid "Removable device disconnected"
msgstr "تم فصل جهاز قابل للإزالة"

msgid "Removable devices"
msgstr "الأجهزة القابلة للإزالة"

msgid "Removable disk"
msgstr "قرص قابل للإزالة"

msgid "Safe to remove"
msgstr "آمن للإزالة"

msgid "Safe to unplug."
msgstr "يمكنك الآن فصل الجهاز."

msgid "Safely remove"
msgstr "إزالة آمنة"

msgid "Scanner"
msgstr "ماسح ضوئي"

msgid "Security key / Smart card"
msgstr "مفتاح أمان / بطاقة ذكية"

msgid "Serial device / Board"
msgstr "جهاز تسلسلي / لوحة"

msgid "Show keyboards and mice"
msgstr "إظهار لوحات المفاتيح والفئران"

msgid "Show notifications"
msgstr "إظهار الإشعارات"

#. botón cuadrado
msgid "Square button"
msgstr "زر مربع"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "الجهاز قيد الاستخدام من قبل تطبيق آخر. أغلق الملفات أو الطرفيات المفتوحة عليه ثم حاول مجدداً."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "تم إلغاء تحميل الأقسام، لكن تعذّر إخراج القرص."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "الهاتف متصل للشحن أو لتصحيح أخطاء USB فقط. لرؤية ملفاته، افتح قفله واختر «نقل الملفات» في إشعار USB الخاص به."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "يختفي هذا الزر عندما لا يكون أي جهاز متصلاً ويظهر مجدداً عند توصيل جهاز."

msgid "USB device"
msgstr "جهاز USB"

msgid "USB device connected"
msgstr "تم توصيل جهاز USB"

msgid "USB device disconnected"
msgstr "تم فصل جهاز USB"

msgid "Unknown"
msgstr "غير معروف"

msgid "Unmount"
msgstr "إلغاء التحميل"

msgid "Unmount failed"
msgstr "فشل إلغاء التحميل"

msgid "Unmounting…"
msgstr "جارٍ إلغاء التحميل…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "استخدام حجم اللوحة للأيقونة"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "يستخدم سمة أصوات سطح المكتب. لن يُشغَّل أي صوت إذا كانت أصوات الأحداث معطّلة في إعدادات المظهر."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "يمكنك الآن وضعه حيث تشاء: نقرة يمنى ← نقل."

msgid "You can now unplug the device."
msgstr "يمكنك الآن فصل الجهاز."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "غير محمّل"
