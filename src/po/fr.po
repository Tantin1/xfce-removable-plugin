#, c-format
msgid "%s free of %s"
msgstr "%s libres sur %s"

msgid "Also hide when only other devices are present"
msgstr "Masquer aussi quand il n'y a que d'autres périphériques"

msgid "Android phone"
msgstr "Téléphone Android"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Apparence"

msgid "Attached to the panel"
msgstr "Collée au tableau de bord"

msgid "Audio device"
msgstr "Périphérique audio"

msgid "Automatic"
msgstr "Automatique"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Automatique : flottante avec des coins arrondis quand le thème et le compositeur le permettent, sinon collée au tableau de bord."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Comportement"

msgid "Camera (PTP)"
msgstr "Appareil photo (PTP)"

msgid "Camera / Webcam"
msgstr "Caméra / Webcam"

msgid "Close"
msgstr "Fermer"

msgid "Could not close the connection to the device."
msgstr "Impossible de fermer la connexion avec le périphérique."

msgid "Could not mount the device."
msgstr "Impossible de monter le périphérique."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Impossible d'ouvrir le périphérique. S'il s'agit d'un téléphone, déverrouillez-le et choisissez « Transfert de fichiers » dans sa notification USB."

msgid "Could not unmount the device."
msgstr "Impossible de démonter le périphérique."

msgid "Device ejected"
msgstr "Périphérique éjecté"

msgid "Device mounted"
msgstr "Périphérique monté"

msgid "Eject"
msgstr "Éjecter"

msgid "Eject failed"
msgstr "Échec de l'éjection"

msgid "Ejecting…"
msgstr "Éjection…"

msgid "File transfer is off"
msgstr "Transfert de fichiers désactivé"

msgid "Floating"
msgstr "Flottante"

msgid "Gamepad / Joystick"
msgstr "Manette / Joystick"

msgid "Graphics tablet"
msgstr "Tablette graphique"

msgid "Hide button when no removable devices"
msgstr "Masquer le bouton s'il n'y a pas de périphériques amovibles"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Taille de l'icône :"

msgid "Keyboard / Mouse"
msgstr "Clavier / souris"

msgid "MIDI device"
msgstr "Périphérique MIDI"

msgid "Mount"
msgstr "Monter"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Monter et retirer en toute sécurité disques, téléphones et autres périphériques USB"

msgid "Mount failed"
msgstr "Échec du montage"

msgid "Mounting…"
msgstr "Montage…"

msgid "No driver: games may not detect it"
msgstr "Sans pilote : les jeux risquent de ne pas la détecter"

msgid "No removable devices"
msgstr "Aucun périphérique amovible"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Aucun pilote du système n'a pris en charge cette manette : la plupart des jeux ne la détecteront pas (Steam peut quand même l'utiliser). Une cause fréquente est un paquet qui bloque le pilote xpad, comme xone."

msgid "Not authorized to perform this operation."
msgstr "Non autorisé à effectuer cette opération."

msgid "Notify about:"
msgstr "Notifier pour :"

msgid "Notify when devices are connected or disconnected"
msgstr "Notifier la connexion ou la déconnexion d'un périphérique"

msgid "Open folder"
msgstr "Ouvrir le dossier"

msgid "Other devices"
msgstr "Autres périphériques"

msgid "Phone"
msgstr "Téléphone"

msgid "Phone (MTP)"
msgstr "Téléphone (MTP)"

msgid "Phone / Camera"
msgstr "Téléphone / Appareil photo"

msgid "Phone or camera connected"
msgstr "Téléphone ou appareil photo connecté"

msgid "Phone or camera disconnected"
msgstr "Téléphone ou appareil photo déconnecté"

msgid "Phone ready"
msgstr "Téléphone prêt"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Jouer un son à la connexion ou à la déconnexion d'un périphérique"

msgid "Please wait, do not unplug."
msgstr "Veuillez patienter, ne débranchez pas."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Taille du plugin :"

#. alto del popup
msgid "Popup height:"
msgstr "Hauteur du popup :"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Style de la fenêtre :"

#. ancho del popup
msgid "Popup width:"
msgstr "Largeur du popup :"

msgid "Printer"
msgstr "Imprimante"

msgid "Properties — Removable Devices"
msgstr "Propriétés — Périphériques amovibles"

msgid "Removable Devices"
msgstr "Périphériques amovibles"

msgid "Removable Devices added"
msgstr "Périphériques amovibles ajouté"

msgid "Removable device connected"
msgstr "Périphérique amovible connecté"

msgid "Removable device disconnected"
msgstr "Périphérique amovible déconnecté"

msgid "Removable devices"
msgstr "Périphériques amovibles"

msgid "Removable disk"
msgstr "Disque amovible"

msgid "Safe to remove"
msgstr "Retrait sécurisé"

msgid "Safe to unplug."
msgstr "Vous pouvez débrancher le périphérique."

msgid "Safely remove"
msgstr "Retirer en toute sécurité"

msgid "Scanner"
msgstr "Scanner"

msgid "Security key / Smart card"
msgstr "Clé de sécurité / Carte à puce"

msgid "Serial device / Board"
msgstr "Périphérique série / Carte"

msgid "Show keyboards and mice"
msgstr "Afficher les claviers et les souris"

msgid "Show notifications"
msgstr "Afficher les notifications"

#. botón cuadrado
msgid "Square button"
msgstr "Bouton carré"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "Le périphérique est utilisé par une autre application. Fermez les fichiers ou terminaux ouverts dessus et réessayez."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "Les partitions ont été démontées, mais le lecteur n'a pas pu être éjecté."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Le téléphone est connecté uniquement pour la recharge ou le débogage USB. Pour voir ses fichiers, déverrouillez-le et choisissez « Transfert de fichiers » dans sa notification USB."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Ce bouton se masque quand rien n'est connecté et réapparaît lorsque vous connectez un périphérique."

msgid "USB device"
msgstr "Périphérique USB"

msgid "USB device connected"
msgstr "Périphérique USB connecté"

msgid "USB device disconnected"
msgstr "Périphérique USB déconnecté"

msgid "Unknown"
msgstr "Inconnu"

msgid "Unmount"
msgstr "Démonter"

msgid "Unmount failed"
msgstr "Échec du démontage"

msgid "Unmounting…"
msgstr "Démontage…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Utiliser la taille du panneau pour l'icône"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Utilise le thème sonore du bureau. Aucun son n'est joué si les sons d'événements sont désactivés dans les paramètres d'Apparence."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "Vous pouvez maintenant le placer où vous voulez : clic droit → Déplacer."

msgid "You can now unplug the device."
msgstr "Vous pouvez maintenant débrancher le périphérique."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "non monté"
