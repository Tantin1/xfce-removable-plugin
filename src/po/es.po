#, c-format
msgid "%s free of %s"
msgstr "%s libres de %s"

msgid "Also hide when only other devices are present"
msgstr "Ocultar también cuando solo haya otros dispositivos"

msgid "Android phone"
msgstr "Teléfono Android"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Apariencia"

msgid "Attached to the panel"
msgstr "Pegada al panel"

msgid "Audio device"
msgstr "Dispositivo de audio"

msgid "Automatic"
msgstr "Automático"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Automático: flotante con esquinas redondeadas cuando el tema y el compositor lo permiten; si no, pegada al panel."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Comportamiento"

msgid "Camera (PTP)"
msgstr "Cámara (PTP)"

msgid "Camera / Webcam"
msgstr "Cámara / Webcam"

msgid "Close"
msgstr "Cerrar"

msgid "Could not close the connection to the device."
msgstr "No se pudo cerrar la conexión con el dispositivo."

msgid "Could not mount the device."
msgstr "No se pudo montar el dispositivo."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "No se pudo abrir el dispositivo. Si es un teléfono, desbloquéelo y elija «Transferencia de archivos» en su notificación USB."

msgid "Could not unmount the device."
msgstr "No se pudo desmontar el dispositivo."

msgid "Device ejected"
msgstr "Dispositivo expulsado"

msgid "Device mounted"
msgstr "Dispositivo montado"

msgid "Eject"
msgstr "Expulsar"

msgid "Eject failed"
msgstr "Error al expulsar"

msgid "Ejecting…"
msgstr "Expulsando…"

msgid "File transfer is off"
msgstr "Transferencia de archivos desactivada"

msgid "Floating"
msgstr "Flotante"

msgid "Gamepad / Joystick"
msgstr "Gamepad / Joystick"

msgid "Graphics tablet"
msgstr "Tableta gráfica"

msgid "Hide button when no removable devices"
msgstr "Ocultar botón si no hay dispositivos extraíbles"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Tamaño del ícono:"

msgid "Keyboard / Mouse"
msgstr "Teclado / mouse"

msgid "MIDI device"
msgstr "Dispositivo MIDI"

msgid "Mount"
msgstr "Montar"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Montar y quitar con seguridad unidades, teléfonos y otros dispositivos USB"

msgid "Mount failed"
msgstr "Error al montar"

msgid "Mounting…"
msgstr "Montando…"

msgid "No driver: games may not detect it"
msgstr "Sin driver: los juegos podrían no detectarlo"

msgid "No removable devices"
msgstr "No hay dispositivos extraíbles"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Ningún driver del sistema tomó este mando, así que la mayoría de los juegos no lo detectará (Steam sí puede usarlo). Una causa común es un paquete que bloquea el driver xpad, como xone."

msgid "Not authorized to perform this operation."
msgstr "No tiene autorización para realizar esta operación."

msgid "Notify about:"
msgstr "Notificar sobre:"

msgid "Notify when devices are connected or disconnected"
msgstr "Notificar cuando se conecten o desconecten dispositivos"

msgid "Open folder"
msgstr "Abrir carpeta"

msgid "Other devices"
msgstr "Otros dispositivos"

msgid "Phone"
msgstr "Teléfono"

msgid "Phone (MTP)"
msgstr "Teléfono (MTP)"

msgid "Phone / Camera"
msgstr "Teléfono / Cámara"

msgid "Phone or camera connected"
msgstr "Teléfono o cámara conectado"

msgid "Phone or camera disconnected"
msgstr "Teléfono o cámara desconectado"

msgid "Phone ready"
msgstr "Teléfono listo"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Reproducir un sonido cuando se conecten o desconecten dispositivos"

msgid "Please wait, do not unplug."
msgstr "Por favor espere, no desconecte."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Tamaño del plugin:"

#. alto del popup
msgid "Popup height:"
msgstr "Alto del popup:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Estilo de la ventana:"

#. ancho del popup
msgid "Popup width:"
msgstr "Ancho del popup:"

msgid "Printer"
msgstr "Impresora"

msgid "Properties — Removable Devices"
msgstr "Propiedades — Dispositivos extraíbles"

msgid "Removable Devices"
msgstr "Dispositivos extraíbles"

msgid "Removable Devices added"
msgstr "Dispositivos extraíbles agregado"

msgid "Removable device connected"
msgstr "Dispositivo extraíble conectado"

msgid "Removable device disconnected"
msgstr "Dispositivo extraíble desconectado"

msgid "Removable devices"
msgstr "Dispositivos extraíbles"

msgid "Removable disk"
msgstr "Disco extraíble"

msgid "Safe to remove"
msgstr "Seguro para retirar"

msgid "Safe to unplug."
msgstr "Puede desconectar el dispositivo."

msgid "Safely remove"
msgstr "Quitar con seguridad"

msgid "Scanner"
msgstr "Escáner"

msgid "Security key / Smart card"
msgstr "Llave de seguridad / Tarjeta inteligente"

msgid "Serial device / Board"
msgstr "Dispositivo serie / Placa"

msgid "Show keyboards and mice"
msgstr "Mostrar teclados y mouses"

msgid "Show notifications"
msgstr "Mostrar notificaciones"

#. botón cuadrado
msgid "Square button"
msgstr "Botón cuadrado"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "El dispositivo está en uso por otra aplicación. Cierre los archivos o terminales abiertos en él e inténtelo de nuevo."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "Las particiones se desmontaron, pero no se pudo expulsar la unidad."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "El teléfono está conectado solo para cargar o para depuración USB. Para ver sus archivos, desbloquéelo y elija «Transferencia de archivos» en su notificación USB."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Este botón se oculta cuando no hay nada conectado y vuelve a aparecer al conectar un dispositivo."

msgid "USB device"
msgstr "Dispositivo USB"

msgid "USB device connected"
msgstr "Dispositivo USB conectado"

msgid "USB device disconnected"
msgstr "Dispositivo USB desconectado"

msgid "Unknown"
msgstr "Desconocido"

msgid "Unmount"
msgstr "Desmontar"

msgid "Unmount failed"
msgstr "Error al desmontar"

msgid "Unmounting…"
msgstr "Desmontando…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Usar tamaño del panel para el ícono"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Usa el tema de sonidos del escritorio. No suena nada si los sonidos de eventos están desactivados en la configuración de Apariencia."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "Ahora puede ubicarlo donde prefiera: clic derecho → Mover."

msgid "You can now unplug the device."
msgstr "Ya puede desconectar el dispositivo."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "sin montar"
