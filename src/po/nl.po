#, c-format
msgid "%s free of %s"
msgstr "%s vrij van %s"

msgid "Also hide when only other devices are present"
msgstr "Ook verbergen wanneer er alleen andere apparaten zijn"

msgid "Android phone"
msgstr "Android-telefoon"

#. ---- frame Apariencia ----
msgid "Appearance"
msgstr "Uiterlijk"

msgid "Attached to the panel"
msgstr "Vast aan het paneel"

msgid "Audio device"
msgstr "Audioapparaat"

msgid "Automatic"
msgstr "Automatisch"

msgid "Automatic: floating with rounded corners when the theme and the compositor allow it, otherwise attached to the panel."
msgstr "Automatisch: zwevend met afgeronde hoeken als het thema en de compositor dat toelaten, anders vast aan het paneel."

#. ---- frame Comportamiento ----
msgid "Behavior"
msgstr "Gedrag"

msgid "Camera (PTP)"
msgstr "Camera (PTP)"

msgid "Camera / Webcam"
msgstr "Camera / Webcam"

msgid "Close"
msgstr "Sluiten"

msgid "Could not close the connection to the device."
msgstr "Kan de verbinding met het apparaat niet sluiten."

msgid "Could not mount the device."
msgstr "Het apparaat kon niet worden aangekoppeld."

msgid "Could not open the device. If it is a phone, unlock it and choose \"File transfer\" in its USB notification."
msgstr "Kan het apparaat niet openen. Als het een telefoon is, ontgrendel deze en kies ‘Bestandsoverdracht’ in de USB-melding."

msgid "Could not unmount the device."
msgstr "Het apparaat kon niet worden ontkoppeld."

msgid "Device ejected"
msgstr "Apparaat uitgeworpen"

msgid "Device mounted"
msgstr "Apparaat aangekoppeld"

msgid "Eject"
msgstr "Uitwerpen"

msgid "Eject failed"
msgstr "Uitwerpen mislukt"

msgid "Ejecting…"
msgstr "Uitwerpen…"

msgid "File transfer is off"
msgstr "Bestandsoverdracht staat uit"

msgid "Floating"
msgstr "Zwevend"

msgid "Gamepad / Joystick"
msgstr "Gamepad / Joystick"

msgid "General"
msgstr "Algemeen"

msgid "Graphics tablet"
msgstr "Tekentablet"

msgid "Hide button when no removable devices"
msgstr "Knop verbergen als er geen verwijderbare apparaten zijn"

#. tamaño del ícono
msgid "Icon size:"
msgstr "Pictogramgrootte:"

msgid "Keyboard / Mouse"
msgstr "Toetsenbord / muis"

msgid "MIDI device"
msgstr "MIDI-apparaat"

msgid "Mount"
msgstr "Koppelen"

msgid "Mount and safely remove drives, phones and other USB devices"
msgstr "Stations, telefoons en andere USB-apparaten koppelen en veilig verwijderen"

msgid "Mount failed"
msgstr "Koppelen mislukt"

msgid "Mounting…"
msgstr "Koppelen…"

msgid "No driver: games may not detect it"
msgstr "Geen stuurprogramma: games herkennen hem mogelijk niet"

msgid "No removable devices"
msgstr "Geen verwijderbare apparaten"

msgid "No system driver has taken this controller, so most games will not detect it (Steam can still use it). A common cause is a package that blocks the xpad driver, such as xone."
msgstr "Geen systeemstuurprogramma heeft deze controller overgenomen, dus de meeste games herkennen hem niet (Steam kan hem nog wel gebruiken). Een veelvoorkomende oorzaak is een pakket dat het stuurprogramma xpad blokkeert, zoals xone."

msgid "Not authorized to perform this operation."
msgstr "Niet bevoegd om deze bewerking uit te voeren."

msgid "Notifications"
msgstr "Meldingen"

msgid "Notify about:"
msgstr "Melden bij:"

msgid "Notify when devices are connected or disconnected"
msgstr "Melden wanneer apparaten worden aangesloten of losgekoppeld"

msgid "Open folder"
msgstr "Map openen"

msgid "Other devices"
msgstr "Andere apparaten"

msgid "Phone"
msgstr "Telefoon"

msgid "Phone (MTP)"
msgstr "Telefoon (MTP)"

msgid "Phone / Camera"
msgstr "Telefoon / Camera"

msgid "Phone or camera connected"
msgstr "Telefoon of camera aangesloten"

msgid "Phone or camera disconnected"
msgstr "Telefoon of camera losgekoppeld"

msgid "Phone ready"
msgstr "Telefoon gereed"

msgid "Play a sound when devices are connected or disconnected"
msgstr "Een geluid afspelen wanneer apparaten worden aangesloten of losgekoppeld"

msgid "Please wait, do not unplug."
msgstr "Even geduld, niet loskoppelen."

#. tamaño del plugin
msgid "Plugin size:"
msgstr "Plugingrootte:"

#. alto del popup
msgid "Popup height:"
msgstr "Popuphoogte:"

#. estilo de la ventana: el orden de los textos es el de POPUP_STYLE_*
msgid "Popup style:"
msgstr "Vensterstijl:"

#. ancho del popup
msgid "Popup width:"
msgstr "Popupbreedte:"

msgid "Printer"
msgstr "Printer"

msgid "Properties — Removable Devices"
msgstr "Eigenschappen — Verwijderbare apparaten"

msgid "Removable Devices"
msgstr "Verwijderbare apparaten"

msgid "Removable Devices added"
msgstr "Verwijderbare apparaten toegevoegd"

msgid "Removable device connected"
msgstr "Verwijderbaar apparaat aangesloten"

msgid "Removable device disconnected"
msgstr "Verwijderbaar apparaat losgekoppeld"

msgid "Removable devices"
msgstr "Verwijderbare apparaten"

msgid "Removable disk"
msgstr "Verwijderbare schijf"

msgid "Safe to remove"
msgstr "Veilig verwijderen"

msgid "Safe to unplug."
msgstr "U kunt het apparaat nu loskoppelen."

msgid "Safely remove"
msgstr "Veilig verwijderen"

msgid "Scanner"
msgstr "Scanner"

msgid "Security key / Smart card"
msgstr "Beveiligingssleutel / Smartcard"

msgid "Serial device / Board"
msgstr "Serieel apparaat / Bord"

msgid "Show keyboards and mice"
msgstr "Toetsenborden en muizen tonen"

msgid "Show notifications"
msgstr "Meldingen weergeven"

#. botón cuadrado
msgid "Square button"
msgstr "Vierkante knop"

msgid "The device is in use by another application. Close any open files or terminals on it and try again."
msgstr "Het apparaat wordt gebruikt door een ander programma. Sluit geopende bestanden of terminals erop en probeer het opnieuw."

msgid "The partitions were unmounted, but the drive could not be ejected."
msgstr "De partities zijn ontkoppeld, maar het station kon niet worden uitgeworpen."

msgid "The phone is connected only for charging or USB debugging. To see its files, unlock it and choose \"File transfer\" in its USB notification."
msgstr "De telefoon is alleen verbonden om op te laden of voor USB-foutopsporing. Ontgrendel hem en kies ‘Bestandsoverdracht’ in de USB-melding om de bestanden te zien."

msgid "This button hides when nothing is connected and reappears when you connect a device."
msgstr "Deze knop wordt verborgen als er niets is aangesloten en verschijnt weer zodra u een apparaat aansluit."

msgid "USB device"
msgstr "USB-apparaat"

msgid "USB device connected"
msgstr "USB-apparaat aangesloten"

msgid "USB device disconnected"
msgstr "USB-apparaat losgekoppeld"

msgid "Unknown"
msgstr "Onbekend"

msgid "Unmount"
msgstr "Ontkoppelen"

msgid "Unmount failed"
msgstr "Ontkoppelen mislukt"

msgid "Unmounting…"
msgstr "Ontkoppelen…"

#. ícono del panel
msgid "Use panel icon size"
msgstr "Panelgrootte gebruiken voor pictogram"

msgid "Uses the desktop sound theme. Nothing plays if event sounds are turned off in the Appearance settings."
msgstr "Gebruikt het geluidsthema van het bureaublad. Er klinkt niets als gebeurtenisgeluiden uitgeschakeld zijn in de instellingen voor Uiterlijk."

msgid "You can now place it wherever you like: right-click → Move."
msgstr "U kunt hem nu plaatsen waar u wilt: rechtsklik → Verplaatsen."

msgid "You can now unplug the device."
msgstr "U kunt het apparaat nu loskoppelen."

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "not mounted"
msgstr "niet gekoppeld"
