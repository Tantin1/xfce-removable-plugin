# Maintainer: Tantin1 <juanperez33840@gmail.com>
#
# Esta copia es la plantilla: queda con sha256sums=('SKIP') a propósito, porque
# la suma del tarball de una etiqueta no se conoce antes de crear la etiqueta.
# El workflow de GitHub (.github/workflows/paquetes.yml) arma el paquete desde
# el commit y no necesita la suma.
#
# Para el AUR, en una copia aparte y con la etiqueta v$pkgver ya publicada:
#   updpkgsums                          # reemplaza SKIP por la suma real
#   makepkg -si                         # probar que compila e instala
#   makepkg --printsrcinfo > .SRCINFO   # el AUR exige este archivo
# (no copiar de vuelta al repo la versión con la suma)

pkgname=xfce-removable-plugin
pkgver=1.0.4
pkgrel=1
pkgdesc='Xfce panel plugin for removable drives, phones and other USB devices'
arch=('x86_64' 'aarch64')
url='https://github.com/Tantin1/xfce-removable-plugin'
license=('GPL-2.0-only')
depends=('xfce4-panel' 'gtk3' 'glib2' 'libnotify' 'libgudev' 'libcanberra' 'udisks2')
makedepends=('meson' 'gettext')
optdepends=('gvfs-mtp: Android phones in file transfer mode'
            'gvfs-gphoto2: cameras (PTP)'
            'gvfs-afc: iPhone / iPad'
            'sound-theme-freedesktop: connect and disconnect sounds')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  arch-meson "$pkgname-$pkgver/src" build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
